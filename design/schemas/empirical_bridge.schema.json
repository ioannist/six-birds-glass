{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sixbirds-glass/empirical_bridge.schema.json",
  "title": "GB10 five-field empirical bridge record (F-II prop:empirical-bridge)",
  "description": "One record per lab literature (Kovacs PVAc / spin glass / colloid). Bridge claims only — never realization. Field names fixed by F-II.",
  "type": "object",
  "required": ["bridge_id", "substrate_observable", "instrument", "level_map", "threshold_witness_relation", "suppressed_structure_nonclaims", "sources", "status"],
  "properties": {
    "bridge_id": { "enum": ["kovacs_pvac", "spin_glass_memory", "colloid_aging"] },
    "substrate_observable": {
      "type": "object",
      "required": ["substrate", "observable", "protocol"],
      "properties": {
        "substrate": { "type": "string" },
        "observable": { "type": "string" },
        "protocol": { "type": "string" }
      }
    },
    "instrument": {
      "type": "object",
      "required": ["apparatus", "resolution", "visibility_record"],
      "properties": {
        "apparatus": { "type": "string" },
        "resolution": { "type": "string" },
        "visibility_record": { "type": "object", "required": ["visible", "suppressed"], "properties": { "visible": { "type": "array", "items": { "type": "string" } }, "suppressed": { "type": "array", "items": { "type": "string" } } } },
        "digitization": { "type": "object", "description": "when data extracted from published figures: figure ref, tool, estimated error" }
      }
    },
    "level_map": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["formal_object", "formal_artifact_hash", "measured_structure"],
        "properties": {
          "formal_object": { "type": "string" },
          "formal_artifact_hash": { "type": "string", "description": "must resolve to an existing glass artifact" },
          "measured_structure": { "type": "string" }
        }
      }
    },
    "threshold_witness_relation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["signature", "criterion", "threshold_value"],
        "properties": {
          "signature": { "type": "string" },
          "criterion": { "type": "string" },
          "threshold_value": { "type": "string", "description": "declared numeral(s); declared before reanalysis" }
        }
      }
    },
    "suppressed_structure_nonclaims": {
      "type": "array",
      "minItems": 4,
      "items": { "type": "string" },
      "description": "must include: no realization claim; no continuum-limit claim; microscopic detail suppressed; KCM kinetics are not the lab kinetics"
    },
    "sources": { "type": "array", "items": { "type": "object", "required": ["citation"], "properties": { "citation": { "type": "string" }, "data_location": { "type": "string" } } } },
    "status": { "enum": ["complete", "pending_source"] }
  }
}
