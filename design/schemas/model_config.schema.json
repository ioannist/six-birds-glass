{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sixbirds-glass/model_config.schema.json",
  "title": "Glass run configuration",
  "description": "Single source of truth for one experiment run. Content-hash of the canonical (sorted-keys, no-whitespace) serialization is the run id. Rationals are strings 'p/q'.",
  "type": "object",
  "required": ["config_version", "model", "epsilon_grid", "lens", "protocol", "arithmetic"],
  "additionalProperties": false,
  "properties": {
    "config_version": { "const": 1 },
    "run_label": { "type": "string" },
    "model": {
      "type": "object",
      "required": ["family", "N", "boundary"],
      "additionalProperties": false,
      "properties": {
        "family": { "enum": ["east", "fa1f", "trap", "rem"] },
        "N": { "type": "integer", "minimum": 2, "maximum": 32, "description": "spins (east/fa1f, certificates ≤ 12, MC sweeps ≤ 20), traps M (trap, ≤ 32), K bits (rem, ≤ 8)" },
        "boundary": { "enum": ["wall_up", "none"], "description": "east/fa1f: wall_up mandatory for certificates" },
        "trap_weights": {
          "type": "object",
          "description": "trap/rem only: per-grid-epsilon declared rational weight vectors",
          "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/rational" } }
        }
      }
    },
    "epsilon_grid": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rational" },
      "description": "Declared finite grid of Boltzmann activation values (formal objects). Physical T is annotation only."
    },
    "annotations_bridge": {
      "type": "object",
      "description": "Ann_Bridge: physical readings of formal parameters (informative, never computed on).",
      "additionalProperties": true
    },
    "lens": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "enum": ["L_energy", "L_energy_phase", "L_panel", "L_Tf", "L_trap_band"] },
        "refinement": {
          "type": "array",
          "description": "GB5 repair-class member: optional declared refinement, as an explicit partition of lens fibers",
          "items": { "type": "object" }
        }
      }
    },
    "protocol": {
      "type": "object",
      "required": ["id", "word"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "description": "catalog name, e.g. P_kovacs(t_w=200)" },
        "word": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["epsilon", "steps"],
            "additionalProperties": false,
            "properties": {
              "epsilon": { "$ref": "#/$defs/rational" },
              "steps": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "cyclic": { "type": "boolean", "default": false },
        "initial_distribution": { "enum": ["equilibrium_first_leg", "explicit"], "default": "equilibrium_first_leg" },
        "initial_explicit": { "type": "object", "description": "state->rational prob map when initial_distribution=explicit", "additionalProperties": { "$ref": "#/$defs/rational" } }
      }
    },
    "continuations": {
      "type": "object",
      "description": "GB3 declared probe catalog defining future signatures; see continuation_catalog.schema.json",
      "properties": { "catalog_ref": { "type": "string" } }
    },
    "arithmetic": {
      "type": "object",
      "required": ["mode"],
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["exact_rational", "float64_sweep"] },
        "max_denominator_bits": { "type": "integer", "default": 4096 },
        "seeds": { "type": "array", "items": { "type": "integer" }, "description": "float64_sweep only" }
      }
    }
  },
  "$defs": {
    "rational": {
      "type": "string",
      "pattern": "^-?[0-9]+/[1-9][0-9]*$",
      "description": "exact rational as 'p/q', canonical lowest terms, q>0"
    }
  }
}
